{
  "name": "fullquizz-firebase-functions",
  "version": "1.0.0",
  "description": "Backend Cloud Functions for FullQuizz real-time multiplayer rooms, answer verification, and Firestore sync",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions,firestore:rules"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "private": true
}
